# ── Database ────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://fairhire:fairhire@db:5432/fairhire

# ── Redis ───────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
RQ_REDIS_URL=redis://redis:6379/0

# ── Frontend ────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# ── Backend ─────────────────────────────────────────────────────────
SECRET_KEY=change-this-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=60
UPLOAD_DIR=/app/app/storage/uploads
STUDIO_EXPORT_DIR=/app/app/storage/exports
STUDIO_MAX_UPLOAD_MB=10
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=INFO
LOG_FORMAT=console
ANALYSIS_STALE_AFTER_MINUTES=15
REDIS_SOCKET_TIMEOUT_SECONDS=600
MAX_QUEUE_DEPTH=200
JOB_TTL_SECONDS=1800
MAX_ATTEMPTS=3
RETRY_BACKOFF_BASE_SECONDS=10
JOB_HARD_TIMEOUT_SECONDS=300
JOB_STEP_TIMEOUT_SECONDS=120
MAX_INPUT_CHARS=20000
MAX_LLM_CALLS_PER_JOB=5
ESTIMATED_COST_PER_CALL=0.002
OPEN_WEIGHTS_REASONER_MODEL_PATH=
OPEN_WEIGHTS_REASONER_MAX_TOKENS=320
OPEN_WEIGHTS_REASONER_TEMPERATURE=0.1
