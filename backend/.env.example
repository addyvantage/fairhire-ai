PROJECT_NAME=FairHire-AI
API_V1_PREFIX=/api/v1
SECRET_KEY=change-this-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=60
DATABASE_URL=postgresql+asyncpg://fairhire:fairhire@db:5432/fairhire
UPLOAD_DIR=app/storage/uploads
STUDIO_EXPORT_DIR=app/storage/exports
STUDIO_MAX_UPLOAD_MB=10
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Redis
REDIS_URL=redis://redis:6379/0
RQ_REDIS_URL=redis://redis:6379/0

# Embedding
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
EMBEDDING_CACHE_L1_SIZE=1000
EMBEDDING_CACHE_TTL_SECONDS=86400
OPEN_WEIGHTS_REASONER_MODEL_PATH=
OPEN_WEIGHTS_REASONER_MAX_TOKENS=320
OPEN_WEIGHTS_REASONER_TEMPERATURE=0.1

# Async job queue
QUEUE_NAME=fairhire:analysis
ASYNC_JOB_RETRY_MAX=3
ASYNC_JOB_RETRY_INTERVAL=10,30,60
ANALYSIS_STALE_AFTER_MINUTES=15
REDIS_SOCKET_TIMEOUT_SECONDS=600

# Worker
WORKER_HEARTBEAT_INTERVAL_SECONDS=30
WORKER_HEARTBEAT_TTL_SECONDS=90

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=console
